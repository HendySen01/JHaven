NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173

# 配置下列四项以启用账户。应先创建独立的 MySQL 数据库与账号。
# DB_HOST=127.0.0.1
DB_PORT=3306
# DB_NAME=jhaven
# DB_USER=jhaven_app
# DB_PASSWORD=
DB_TLS=0
TRUST_LOOPBACK_PROXY=0

# 可选，空值使用本地知识。密钥仅限服务端，禁止使用 VITE_ 前缀。
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_VERIFIED_OPENAI_MODEL=
AI_OPENAI_DAILY_REQUEST_LIMIT=120
AI_OPENAI_DAILY_BUDGET_USD=0.10
AI_DAILY_REQUEST_LIMIT=120
AI_ACCOUNT_WINDOW_LIMIT=60
AI_GUEST_WINDOW_LIMIT=30
AI_IP_WINDOW_LIMIT=180

# DeepSeek 配置后优先使用，留空保持现有供应商。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_VERIFIED_DEEPSEEK_MODEL=deepseek-flash
AI_DEEPSEEK_DAILY_REQUEST_LIMIT=120
AI_DEEPSEEK_DAILY_BUDGET_USD=0.10
AI_DAILY_BUDGET_USD=0.10
