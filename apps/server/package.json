{
  "name": "@jhaven/server",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@jhaven/shared": "0.1.0-alpha.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  }
}
