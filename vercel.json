{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm --prefix ../.. run audio:verify && npm run build -w @jhaven/shared && npm run build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        {
          "src": "^/(?!assets(?:/|$)|audio(?:/|$))[^.]*$",
          "methods": ["GET", "HEAD"],
          "dest": "/index.html"
        }
      ]
    },
    "server": {
      "root": "apps/server",
      "framework": "express",
      "entrypoint": "app.ts",
      "buildCommand": "npm run build -w @jhaven/shared && node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\""
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
